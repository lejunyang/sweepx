  "scope": [
    "Platform-owned common 256 native I/O reservations, storage-only 128-authority subset retained",
    "Actual primary traversal/content owners share admission with cache/state/audit/journal",
    "Retain public cache marker API, independent scan/rendering contract and backend features",
    "No new crate/third-party dependency/default quota change or performance claim"
  ],
  "semantics": {
    "nativeOwners": "Reserve before syscall. Actual close precedes lease release. Linux admitted root/O_PATH child/readable directory/data/dup; macOS root/child/DIR/mount-only/data; Windows root/relative metadata/directory/data. Unix fdopendir success transfers actual fd and lease separately to stream owner, closedir precedes refund. Error and callback panic unwind close.",
    "errors": "Platform root/detail ResourceLimit and ErrorRecord resource reason; bounded content read adds ResourceLimit(HandleLimit), not NotFound. Locator uses existing resource failure; duplicates use existing read_limit gap. Stable cache marker fields/paths and wire names retained; SQLite callback refusals can remain database I/O errors.",
    "exclusions": "Imported files before admit, arbitrary borrowed duplicates, other discovery/NTFS/Trash native helpers, FSEvents framework-owned resources and Windows security queries remain outside the participating pool. Not a whole-process FD/executive-handle/RSS/hard-deadline bound or reserved terminal persistence capacity.",
    "postMatrixChanges": "Only strengthened final integration oracle to check exact controlled panic payload, then reran both integration cases and target cfg lint. Other unchanged functional matrix reused; docs updated afterwards."
  },
  "oracle": {
    "publicIntegration": "scanner_and_storage_share_actual_io_lifetimes",
    "isolation": "Fresh exec; bounded 30s wait and task-owned child kill/reap guard",
    "scanRoots": 16,
    "literalSharedIOLimit": 256,
    "ordinaryUnixOracle": "Snapshot /dev/fd or /proc/self/fd names then ordinary file metadata, counted by independently observed fixture device/inode. No production counters or backend private fields. Ignore later oracle aliases.",
    "windowsOracle": "GetProcessHandleCount baseline/delta; cfg compiled, not executed",
    "macOSRetainedAtCap": 256,
    "allReleased": "independent count returns to baseline",
    "refusals": [
      "New native root",
      "Ordinary Scanner root admission",
      "Native file mount inspection",
      "Storage child acquisition",
      "Bounded content typed resource error, never verified absence"
    ],
    "lifetimeChecks": [
      "Cancellation remains before admission",
      "Original payload bytes preserved",
      "Release one real data file permits enumeration",
      "Linux separate cursor FD charged and retained to close, compile only",
      "Bound content read recovers after files drop",
      "Exact controlled callback panic payload then original descriptor count restored"
    ],
    "previousCoverageKept": "Existing 128-owner and 256 I/O cache/state/audit consumers, actual 8-worker cloning, retired C file lifetime and strict crash signal tests retained."
  },
