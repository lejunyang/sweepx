  {
    "id": "linux.stale-temp-object",
    "platform": "linux",
    "rootKind": "linux_tmp",
    "matchKind": "stale_inactive_direct_child",
    "names": [],
    "requiredMarkers": [],
    "depth": 0,
    "risk": "R3",
    "evidence": "The candidate is any current-user-owned direct child object of /tmp on the same filesystem. SweepX admits directories, regular files, symlinks, named pipes, and stale Unix-domain sockets; names are never used as evidence. Directories receive a no-follow recursive walk that sums filesystem allocation and uses the newest recursive atime, mtime, and ctime for the seven-day idle threshold. SweepX rejects mount crossings, external hard links, device inodes, bound sockets, and objects referenced through current-user cwd/root/exe/fd views (including held FIFOs seen as pipe inodes), map_files/mountinfo views, or Unix-domain socket tables in observable network namespaces. Other users' references or private namespaces can remain unreadable to an unprivileged process, so cleanup fail-closes whenever that current-user observation is incomplete.",
    "sourceReviewedAt": "2026-09-10",
    "references": [
      "https://refspecs.linuxfoundation.org/FHS_3.0/fhs/ch03s18.html",
      "https://www.freedesktop.org/software/systemd/man/latest/tmpfiles.d.html"
    ]
  },
