    "source": "#include <errno.h>\n#include <fcntl.h>\n#include <pwd.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic int fixture_getpwuid_r(uid_t uid, struct passwd *pwd, char *buffer, size_t length, struct passwd **result) {\n    const char *directory = getenv(\"SWEEPX_NATIVE_HOME\");\n    const char *record = getenv(\"SWEEPX_NATIVE_HOME_RECORD\");\n    const char *mode = getenv(\"SWEEPX_NATIVE_HOME_MODE\");\n    if (!directory || !record || !mode) _exit(125);\n    int fd = open(record, O_WRONLY | O_APPEND | O_CREAT | O_NOFOLLOW, 0600);\n    if (fd < 0) _exit(126);\n    dprintf(fd, \"{\\\"uid\\\":%u,\\\"realUid\\\":%u,\\\"length\\\":%zu,\\\"mode\\\":\\\"%s\\\"}\\n\", (unsigned)uid, (unsigned)getuid(), length, mode);\n    close(fd);\n    *result = NULL;\n    if (!strcmp(mode, \"absent\")) return 0;\n    if (!strcmp(mode, \"error\")) return EIO;\n    if (!strcmp(mode, \"range\")) return ERANGE;\n    size_t needed = strlen(directory) + 1;\n    if (needed > length) return ERANGE;\n    memcpy(buffer, directory, needed);\n    memset(pwd, 0, sizeof(*pwd));\n    pwd->pw_uid = uid;\n    pwd->pw_dir = buffer;\n    *result = pwd;\n    return 0;\n}\n#ifdef __APPLE__\n__attribute__((used)) static struct { const void *replacement; const void *original; } interpose[]\n__attribute__((section(\"__DATA,__interpose\"))) = { {(const void *)fixture_getpwuid_r, (const void *)getpwuid_r} };\n#else\nint getpwuid_r(uid_t uid, struct passwd *pwd, char *buffer, size_t length, struct passwd **result) {\n    return fixture_getpwuid_r(uid, pwd, buffer, length, result);\n}\n#endif\n",
