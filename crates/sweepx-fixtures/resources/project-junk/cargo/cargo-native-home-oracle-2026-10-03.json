ATH':str(cargo.parent)+':/usr/bin:/bin','DYLD_INSERT_LIBRARIES':str(shim)}\n report['cargoVersion']=runner.run_bounded([str(cargo),'--version'],base,dict({k:v for k,v in common.items() if k!='DYLD_INSERT_LIBRARIES'},HOME=str(base),CARGO_HOME=str(base)))\n assert report['cargoVersion']['stdout'].strip()=='cargo 1.98.0 (797e8a9bc 2026-08-05)'\n for name,env_home,env_cargo,mode in cases:\n  root=base/name;project=root/'project';project.mkdir(parents=True)\n  files={'project/Cargo.toml':'[package]\\nname=\"native_home_oracle\"\\nversion=\"0.1.0\"\\nedition=\"2024\"\\n','project/src/lib.rs':'pub fn answer() -> u8 { 42 }\\n','project/target/personal':'preserved\\n','os-home/.cargo/config.toml':'[build]\\ntarget-dir=\"native-output\"\\n','env-home/.cargo/config.toml':'[build]\\ntarget-dir=\"env-output\"\\n','explicit/config.toml':'[build]\\ntarget-dir=\"explicit-output\"\\n'}\n  if mode=='empty': files['project/.cargo/config.toml']='[build]\\ntarget-dir=\"empty-native-output\"\\n'\n  for relative,body in files.items():\n   path=root/relative;path.parent.mkdir(parents=True,exist_ok=True);path.write_text(body)\n  native_value='' if mode=='empty' else str(root/'os-home');record_path=root/'lookup.jsonl'\n  env=dict(common,SWEEPX_NATIVE_HOME=native_value,SWEEPX_NATIVE_HOME_MODE='present' if mode=='empty' else mode,SWEEPX_NATIVE_HOME_RECORD=str(record_path))\n  if env_home is not None:env['HOME']='' if env_home=='' else str(root/env_home)\n  if env_cargo is not None:env['CARGO_HOME']='' if env_cargo=='' else str(root/env_cargo)\n  result=runner.run_bounded([str(cargo),'metadata','--offline','--no-deps','--format-version=1'],project,env)\n  calls=[json.loads(s) for s in record_path.read_text().splitlines()] if record_path.exists() else []\n  assert all(c['uid']==c['realUid'] for c in calls)\n  changes=[p for p,b in files.items() if not (root/p).is_file() or (root/p).read_text()!=b]\n  assert not changes and result['boundedFailure'] is None\n  item={'name':name,'fixtureRoot':str(r