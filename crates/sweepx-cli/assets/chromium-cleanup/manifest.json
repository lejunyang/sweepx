{
  "manifest_version": 3,
  "name": "SweepX \u7f51\u7ad9\u6e05\u7406 / Site cleanup",
  "version": "0.2.1",
  "minimum_chrome_version": "96",
  "description": "Review a local SweepX plan and let the browser clear selected website caches or storage.",
  "permissions": [
    "browsingData",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "SweepX \u7f51\u7ad9\u6e05\u7406"
  },
  "background": {
    "service_worker": "open.js"
  },
  "options_ui": {
    "page": "review.html",
    "open_in_tab": true
  },
  "key": ""
}
