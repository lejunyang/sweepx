{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sweepx.dev/schemas/capability-record/v1",
  "title": "SweepX Capability Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recordedAt",
    "qualificationKey",
    "state",
    "reasonCode",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "sweepx.capability-record/v1"
    },
    "recordedAt": {
      "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/rfc3339Timestamp"
    },
    "qualificationKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coreVersion",
        "scannerSemanticsVersion",
        "safetyPolicyDigest",
        "adapterId",
        "adapterDigest",
        "osFamily",
        "osBuild",
        "arch",
        "filesystem",
        "volumeClass",
        "runtimePrivilegeProfile",
        "capability"
      ],
      "properties": {
        "coreVersion": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "scannerSemanticsVersion": {
          "type": "integer",
          "minimum": 1
        },
        "safetyPolicyDigest": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "adapterId": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "adapterDigest": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "osFamily": {
          "type": "string",
          "enum": [
            "windows",
            "macos",
            "linux"
          ]
        },
        "osBuild": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "arch": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "filesystem": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "volumeClass": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "providerOrDesktopBackend": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "runtimePrivilegeProfile": {
          "type": "string",
          "enum": [
            "ordinary_user",
            "elevated",
            "unknown"
          ]
        },
        "cleanerId": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "cleanerVersion": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "capability": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "qualified",
        "degraded",
        "report_only",
        "unsupported",
        "disabled"
      ]
    },
    "reasonCode": {
      "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
    },
    "reason": {
      "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleDigest",
        "reviewedBy",
        "limitations",
        "invalidatesOn"
      ],
      "properties": {
        "bundleDigest": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
        },
        "reviewedBy": {
          "type": "array",
          "items": {
            "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
          }
        },
        "invalidatesOn": {
          "type": "array",
          "items": {
            "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/nonEmptyString"
          },
          "minItems": 1
        },
        "expiresAt": {
          "$ref": "https://sweepx.dev/schemas/common/v1#/$defs/rfc3339Timestamp"
        }
      }
    }
  }
}
